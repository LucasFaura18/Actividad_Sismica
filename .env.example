# =====================================================================
# CONFIGURACIÓN DEL ENTORNO (.env) - OBSERVATORIO SÍSMICO
# Copia este archivo como .env y ajusta las credenciales locales.
# NUNCA subas el archivo .env ni tus tokens de ngrok al repositorio Git.
# =====================================================================

# Apache Kafka (Broker local dentro de Docker Compose)
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
KAFKA_TOPIC=terremotos.live
KAFKA_GROUP=observatorio-consumidor
# Retención de topic en Kafka: 72 horas (259.200.000 ms)
KAFKA_TOPIC_RETENTION_MS=259200000

# Frecuencia de extracción USGS (en segundos)
POLL_SECONDS=60

# PostgreSQL (Servicio de almacenamiento local)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=CAMBIAR_EN_LOCAL

# Orígenes CORS permitidos (separados por coma).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://actividad-sismica.netlify.app
